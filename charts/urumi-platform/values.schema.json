{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "namespaces"],
  "if": { "properties": { "global": { "properties": { "tls": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] } }, "required": ["tls"] } }, "required": ["global"] },
  "then": { "properties": { "global": { "properties": { "publicScheme": { "const": "https" } } } } },
  "properties": {
    "global": {
      "type": "object",
      "required": ["storeHost", "appHost", "publicScheme", "publicPort", "ingressClassName"],
      "properties": {
        "storeHost": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$" },
        "appHost": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$" },
        "publicScheme": { "type": "string", "enum": ["http", "https"] },
        "publicPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "ingressClassName": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "imageRegistry": { "type": "string" },
        "imageTag": { "type": ["string", "integer"] },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "clusterIssuer": { "type": "string" },
            "secretNamePrefix": { "type": "string" }
          }
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "level": { "type": "string", "enum": ["restricted", "baseline", "privileged"] } }
    },
    "wordpress": {
      "type": "object",
      "properties": {
        "cron": {
          "type": "object",
          "required": ["enabled", "schedule"],
          "properties": {
            "enabled": { "type": "boolean" },
            "schedule": { "type": "string", "minLength": 1 },
            "resources": { "type": "object" }
          }
        }
      }
    },
    "storeSetup": {
      "type": "object",
      "properties": {
        "customerRegistration": { "type": "boolean" },
        "timezone": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$" }
      }
    },
    "namespaces": {
      "type": "object",
      "required": ["store", "mcp", "gateway"],
      "properties": {
        "store": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "mcp": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "gateway": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existing": {
          "type": "object",
          "properties": {
            "storeDb": { "type": "string" },
            "storeAdmin": { "type": "string" },
            "storeWooApi": { "type": "string" },
            "mcpWoocommerceToken": { "type": "string" },
            "mcpNotesToken": { "type": "string" },
            "mcpUtilitiesKey": { "type": "string" },
            "gatewaySecrets": { "type": "string" },
            "gatewayBootstrap": { "type": "string" },
            "llmApiKeys": { "type": "string" }
          }
        }
      }
    },
    "mcpNotes": {
      "type": "object",
      "required": ["enabled", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "object", "properties": { "repository": { "type": "string", "minLength": 1 }, "tag": { "type": ["string", "integer"] } } },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logLevel": { "type": "string" },
        "resources": { "type": "object" }
      }
    },
    "mcpUtilities": {
      "type": "object",
      "required": ["enabled", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "object", "properties": { "repository": { "type": "string", "minLength": 1 }, "tag": { "type": ["string", "integer"] } } },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logLevel": { "type": "string" },
        "resources": { "type": "object" }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["image", "storage"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "storage": { "type": "string", "minLength": 1 },
        "resources": { "type": "object" }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["enabled", "port", "bootstrapAdminEmail"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "object", "properties": { "repository": { "type": "string", "minLength": 1 }, "tag": { "type": ["string", "integer"] } } },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logLevel": { "type": "string" },
        "bootstrapAdminEmail": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
        "healthIntervalMs": { "type": "integer", "minimum": 1000 },
        "healthTimeoutMs": { "type": "integer", "minimum": 500 },
        "callTimeoutMs": { "type": "integer", "minimum": 11000, "maximum": 120000 },
        "mcpAuthFailureLimitPerMin": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "timeoutMs", "maxRetries"],
          "properties": {
            "provider": { "type": "string", "enum": ["groq", "openrouter"] },
            "model": { "type": "string" },
            "baseUrl": { "type": "string", "pattern": "^(https?://[^ ]+)?$" },
            "fallbackProvider": { "type": "string", "enum": ["", "groq", "openrouter"] },
            "fallbackModel": { "type": "string" },
            "timeoutMs": { "type": "integer", "minimum": 5000, "maximum": 120000 },
            "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 },
            "maxOutputTokens": { "type": "integer", "minimum": 256, "maximum": 4096 }
          }
        },
        "chat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turnTimeoutMs", "maxSteps", "rateLimitPerMin"],
          "properties": {
            "turnTimeoutMs": { "type": "integer", "minimum": 10000, "maximum": 120000 },
            "maxSteps": { "type": "integer", "minimum": 1, "maximum": 16 },
            "rateLimitPerMin": { "type": "integer", "minimum": 1, "maximum": 120 },
            "topicCheck": { "type": "boolean" },
            "topicCheckModel": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{0,100}$" },
            "topicCheckTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 15000 },
            "dailyTokenBudget": { "type": "integer", "minimum": 0, "maximum": 10000000 }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "networkPolicies": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "dashboard": {
      "type": "object",
      "required": ["enabled", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "object", "properties": { "repository": { "type": "string", "minLength": 1 }, "tag": { "type": ["string", "integer"] } } },
        "port": { "type": "integer", "const": 8080 },
        "resources": { "type": "object" }
      }
    }
  }
}