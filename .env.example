# Copy to .env and fill in real values. Never commit .env.
#
# What goes where:
#  - The API keys (GROQ_API_KEY, OPENROUTER_API_KEY) are pushed to the cluster as the
#    `llm-api-keys` Secret by scripts/create-secrets.ps1 (added in Phase 4, Task 4.7).
#  - LLM_PROVIDER, LLM_MODEL and LLM_FALLBACK_PROVIDER are read by the gateway (apps/gateway/src/config.ts).
#    For the cluster they are Helm values, not read from this file.
#  - Leave a key blank to mean "not configured" (the gateway will report LLM_NOT_CONFIGURED
#    instead of failing with an authentication error).

# ---- LLM providers (chat agent). Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional fallback. Free models: 20 req/min, 50 req/day (1000/day after $10 lifetime credit)
OPENROUTER_API_KEY=
# groq | openrouter
LLM_PROVIDER=groq
# Model id at the chosen provider. Empty means the provider default (Groq: openai/gpt-oss-120b)
LLM_MODEL=
# Optional: provider to try once when the primary is rate limited / down
LLM_FALLBACK_PROVIDER=

# ---- Optional overrides for the bootstrap admin (otherwise Helm generates a password)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
