# Copy to .env and fill in real values. Never commit .env.
#
# What goes where:
#  - The API keys (GROQ_API_KEY, OPENROUTER_API_KEY) will be pushed to the cluster as the
#    `llm-api-keys` Secret by scripts/create-secrets.ps1 (planned, Phase 3; not yet written).
#  - LLM_PROVIDER, LLM_MODEL, LLM_FALLBACK_PROVIDER and BOOTSTRAP_ADMIN_* are local-dev
#    only for now. Mapping them into Helm values is planned for the Phase 3/4 plans
#    (planned); until then the cluster does not read them from this file.
#  - Leave a key blank to mean "not configured" (the gateway will report LLM_NOT_CONFIGURED
#    instead of failing with an authentication error).

# ---- LLM providers (chat agent). Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional fallback. Free models: 20 req/min, 50 req/day (1000/day after $10 lifetime credit)
OPENROUTER_API_KEY=
# groq | openrouter
LLM_PROVIDER=groq
# Model id at the chosen provider (decided in Phase 4 spike)
LLM_MODEL=openai/gpt-oss-120b
# Optional: provider to try once when the primary is rate limited / down
LLM_FALLBACK_PROVIDER=

# ---- Optional overrides for the bootstrap admin (otherwise Helm generates a password)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
