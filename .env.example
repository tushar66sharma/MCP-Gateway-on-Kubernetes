# Copy to .env and fill in real values. Never commit .env.
#
# What goes where:
#  - The API keys (GROQ_API_KEY, OPENROUTER_API_KEY) are the ONLY lines scripts/create-secrets.ps1 reads.
#    It pushes them to the cluster as the Secret `llm-api-keys` (namespace gateway) and restarts the gateway.
#    Step by step: docs/run-guide.md, section "Set up the AI chat".
#  - The other LLM_* and CHAT_* settings are read by the gateway process (apps/gateway/src/config.ts) when you
#    run it outside the cluster. For the cluster they are Helm values (gateway.llm.*, gateway.chat.*), not read
#    from this file. Every variable, default and range: docs/ai-integration.md, section 2.
#  - Leave a key blank to mean "not configured" (the gateway reports LLM_NOT_CONFIGURED instead of failing
#    with an authentication error).
#  - Never paste a real key into a chat, an issue or a commit. .env is git-ignored; this file is not.

# ---- LLM providers (chat agent). Free Groq key: https://console.groq.com/keys (Create API Key, shown once).
# Groq free plan for openai/gpt-oss-120b (2026-10-19): 30 req/min, 1K req/day, 8K tokens/min, 200K tokens/day.
GROQ_API_KEY=
# Optional fallback. Key: https://openrouter.ai/settings/keys. Free (:free) models: 20 req/min, 50 req/day
# (1000/day after buying at least 10 credits once). Used only when LLM_FALLBACK_PROVIDER / the Helm value
# gateway.llm.fallbackProvider is openrouter, or when OpenRouter is the primary provider.
OPENROUTER_API_KEY=
# groq | openrouter (Helm: gateway.llm.provider)
LLM_PROVIDER=groq
# Model id at the chosen provider. Empty means the provider default (Groq: openai/gpt-oss-120b,
# OpenRouter: nvidia/nemotron-3-super-120b-a12b:free). Helm: gateway.llm.model
LLM_MODEL=
# Optional: provider to try once, with no retries, when the primary is rate limited or down. Must differ
# from LLM_PROVIDER. Helm: gateway.llm.fallbackProvider
LLM_FALLBACK_PROVIDER=
# Optional overrides (defaults shown; ranges in docs/ai-integration.md):
# LLM_BASE_URL=              (empty = the provider's own API URL)
# LLM_FALLBACK_MODEL=        (empty = the fallback provider's default model)
# LLM_TIMEOUT_MS=30000       (one request to the provider)
# LLM_MAX_RETRIES=2          (on 429, 5xx and network errors)
# CHAT_TURN_TIMEOUT_MS=60000 (a whole chat turn)
# CHAT_MAX_STEPS=8           (tool steps per turn)
# CHAT_RATE_LIMIT_PER_MIN=10 (turns per user per minute)
# LLM_MAX_OUTPUT_TOKENS=1024 (cap on every main-model answer; 256-4096; Helm: gateway.llm.maxOutputTokens)
# CHAT_TOPIC_CHECK=true      (a small model refuses off-topic messages first; Helm: gateway.chat.topicCheck)
# CHAT_TOPIC_CHECK_MODEL=    (empty = Groq openai/gpt-oss-20b, OpenRouter: the main model)
# CHAT_TOPIC_CHECK_TIMEOUT_MS=5000 (no retries; on any failure the turn runs anyway)
# CHAT_DAILY_TOKEN_BUDGET=50000 (tokens per user per day in STORE_TIMEZONE; 0 = unlimited)
# STORE_TIMEZONE=UTC         (the chart sets it from storeSetup.timezone, Asia/Kolkata locally)

# ---- Optional overrides for the bootstrap admin (otherwise Helm generates a password)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
